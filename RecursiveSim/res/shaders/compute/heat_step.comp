#version 430 core

layout(local_size_x = 16, local_size_y = 16) in;

struct HeatCell {
    float temperature;
    float alpha;
    float source;
};

layout(std430, binding = 0) buffer InputCells {
    HeatCell iCells[];
};

layout(std430, binding = 1) buffer OutputCells {
    HeatCell oCells[];
};

uniform int u_GridWidth;
uniform int u_GridHeight;

int wrapIndex(int index, int maxIndex) {
    return (index + maxIndex) % maxIndex;
}

void main() {
    ivec2 coords = ivec2(gl_GlobalInvocationID.xy);
    if (coords.x >= u_GridWidth || coords.y >= u_GridHeight) return;

    int index = coords.y * u_GridWidth + coords.x;

    int left  = wrapIndex(coords.x - 1, u_GridWidth);
    int right = wrapIndex(coords.x + 1, u_GridWidth);
    int up    = wrapIndex(coords.y - 1, u_GridHeight);
    int down  = wrapIndex(coords.y + 1, u_GridHeight);

    int leftIndex  = coords.y * u_GridWidth + left;
    int rightIndex = coords.y * u_GridWidth + right;
    int upIndex    = up   * u_GridWidth + coords.x;
    int downIndex  = down * u_GridWidth + coords.x;

    HeatCell center = iCells[index];
    HeatCell leftCell  = iCells[leftIndex];
    HeatCell rightCell = iCells[rightIndex];
    HeatCell upCell    = iCells[upIndex];
    HeatCell downCell  = iCells[downIndex];

    // Heat equation: T_new = T_old + alpha*(T_left + T_right + T_up + T_down - 4*T_old) + source
    float laplacian = leftCell.temperature + rightCell.temperature
                    + upCell.temperature   + downCell.temperature
                    - 4.0 * center.temperature;

    oCells[index].temperature = center.temperature + center.alpha * laplacian + center.source;
    oCells[index].alpha  = center.alpha;
    oCells[index].source = center.source;
}
